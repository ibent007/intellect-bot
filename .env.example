# Скопируйте в .env; реальные секреты не публикуйте.
BOT_TOKEN=
TELEGRAM_PROXY_URL=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=bot
POSTGRES_USER=bot
POSTGRES_PASSWORD=
LOG_LEVEL=INFO
HEALTH_PORT=8081

# Адрес вашего OpenAI-совместимого API и выбранная модель.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=60
LLM_MAX_COMPLETION_TOKENS=4096
# Короткий итог после MCP и общий предел контекста с результатами.
LLM_TOOL_RESPONSE_MAX_TOKENS=1024
LLM_TOOL_CONTEXT_MAX_CHARS=12000
# Максимальная суммарная пауза по заголовкам квоты; модель автоматически не меняется.
LLM_MAX_RATE_WAIT_SECONDS=5
LLM_HISTORY_MAX_MESSAGES=12
LLM_CONTEXT_MAX_CHARS=6000

# При локальном запуске сначала соберите решение в Release.
MCP_SERVER_PATH=src/IntellectBot.McpServer/bin/Release/net10.0/IntellectBot.McpServer.dll
# Только для автономного сервера без личной БД:
# Schedule__File=data/demo-schedule.json
# Schedule__TimeZone=Europe/Moscow
